{
    "name": "@vertigis/workflow-sdk",
    "version": "0.0.0-semantically-released",
    "description": "The SDK for extending VertiGIS Studio Workflow",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vertigis/vertigis-workflow-sdk.git"
    },
    "author": "VertiGIS",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/vertigis/vertigis-workflow-sdk/issues"
    },
    "homepage": "https://github.com/vertigis/vertigis-workflow-sdk#readme",
    "files": [
        "bin",
        "config",
        "lib",
        "scripts",
        "template",
        "test"
    ],
    "type": "module",
    "engines": {
        "node": ">=18",
        "npm": ">=8"
    },
    "bin": {
        "vertigis-workflow-sdk": "bin/vertigis-workflow-sdk.js"
    },
    "scripts": {
        "create": "cross-env SDK_LOCAL_DEV=true node bin/vertigis-workflow-sdk.js create",
        "test": "node ./test/index.js",
        "prettier": "prettier --write \"**/*.json\" \"**/*.js\""
    },
    "dependencies": {
        "@vertigis/sdk-library": "~2.1.0",
        "chalk": "~5.3.0",
        "webpack-merge": "~6.0.1"
    },
    "devDependencies": {
        "@types/node": "^22.13.14",
        "@vertigis/workflow": "^5.51.0",
        "conventional-changelog-conventionalcommits": "^7.0.2",
        "cross-env": "^7.0.3",
        "eslint": "^9.32.0",
        "eslint-import-resolver-typescript": "~4.2.2",
        "execa": "^9.0.0",
        "lint-staged": "^16.2.3",
        "node-fetch": "^2.7.0",
        "prettier": "^3.2.5",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "simple-git-hooks": "~2.13.0",
        "typescript": "^5.4.3"
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged"
    },
    "lint-staged": {
        "*.{js,json,ts,tsx,md,xml}": "prettier --write"
    },
    "allowScripts": {
        "@mui/x-telemetry": false,
        "@vaadin/vaadin-usage-statistics": false,
        "playwright-chromium": true,
        "simple-git-hooks": false,
        "unrs-resolver": false
    }
}
