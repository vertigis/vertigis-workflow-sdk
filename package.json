{
    "name": "@vertigis/workflow-sdk",
    "version": "0.0.0-semantically-released",
    "description": "The SDK for extending VertiGIS Studio Workflow",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vertigis/vertigis-workflow-sdk.git"
    },
    "author": "VertiGIS",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/vertigis/vertigis-workflow-sdk/issues"
    },
    "homepage": "https://github.com/vertigis/vertigis-workflow-sdk#readme",
    "files": [
        "bin",
        "config",
        "lib",
        "scripts",
        "template"
    ],
    "type": "module",
    "engines": {
        "node": ">=18",
        "npm": ">=8"
    },
    "bin": {
        "vertigis-workflow-sdk": "bin/vertigis-workflow-sdk.js"
    },
    "scripts": {
        "create": "cross-env SDK_LOCAL_DEV=true node bin/vertigis-workflow-sdk.js create",
        "test": "npm run test:unit && npm run test:e2e",
        "test:e2e": "node ./test/e2e/index.js",
        "test:unit": "jest",
        "test:unit:watch": "npm run test:unit -- --watch",
        "prettier": "prettier --write \"**/*.json\" \"**/*.js\""
    },
    "dependencies": {
        "@vertigis/sdk-library": "^1.0.2",
        "chalk": "~5.3.0",
        "ts-morph": "~9.1.0",
        "webpack-merge": "~6.0.1"
    },
    "devDependencies": {
        "@babel/core": "^7.26.8",
        "@babel/preset-env": "^7.26.8",
        "@babel/preset-typescript": "7.26.0",
        "@types/jest": "^29.5.12",
        "@types/node": "^20.11.30",
        "@types/node-fetch": "^2.6.13",
        "@vertigis/workflow": "^5.46.0",
        "conventional-changelog-conventionalcommits": "^7.0.2",
        "cross-env": "^7.0.3",
        "eslint": "^9.32.0",
        "execa": "^9.0.0",
        "jest": "^30.0.5",
        "node-fetch": "^2.6.7",
        "p-retry": "^4.6.2",
        "prettier": "^3.2.5",
        "pretty-quick": "^4.0.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "simple-git-hooks": "~2.13.0",
        "typescript": "^5.4.3"
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged"
    },
    "lint-staged": {
        "*.{js,json,ts,tsx,md,xml}": "prettier --write"
    }
}
